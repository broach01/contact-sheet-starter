{
  "name": "contact-sheet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && vite build",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "test": "node --test tests/*.test.mjs && npm run test:install",
    "server:dev": "vercel dev",
    "deploy": "vercel --prod",
    "test:install": "node --import ./tests/fixtures/register.mjs tests/install-flow.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
